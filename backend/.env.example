# Copy this file to .env (and, for backend/scripts/*.js, to backend/scripts/.env)
# and fill in real values. Never commit the actual .env file.

# Required
MONGO_URI=
JWT_SECRET=

# Optional — Adzuna job ingestion is skipped cleanly (logged as a
# "missing_credentials" adapter failure, not a crash) if either is unset.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Optional — defaults to 5000 if unset.
PORT=5000

# Optional — defaults to http://localhost:5173 if unset. The origin the
# backend's CORS policy allows.
FRONTEND_URL=http://localhost:5173

# Optional — cron expression for the job-ingestion scheduler. Defaults to
# "0 */6 * * *" (every 6 hours) if unset or invalid.
INGESTION_CRON_SCHEDULE=0 */6 * * *

# Optional — defaults to "development" if unset. Set to "production" in a
# real deployment so Express's default error handler never includes a
# stack trace in an error response.
NODE_ENV=development
