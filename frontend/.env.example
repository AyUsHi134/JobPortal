# Base URL of the JobPortal backend API. Copy this file to `.env` (or
# `.env.local`) and adjust for your environment — Vite exposes any
# VITE_-prefixed variable via `import.meta.env` at build/dev time.
# If unset, the app falls back to http://localhost:5000 (see
# src/services/api.js).
VITE_API_URL=http://localhost:5000
